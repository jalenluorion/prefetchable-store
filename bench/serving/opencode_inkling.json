{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "dmeng": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "dmeng (local)",
      "options": { "baseURL": "http://127.0.0.1:8090/v1", "apiKey": "local", "timeout": false },
      "models": {
        "inkling-2-mini": {
          "name": "Inkling 2 Mini (dmeng, experts on SSD)",
          "tool_call": true,
          "reasoning": true,
          "attachment": false,
          "temperature": true,
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    }
  },
  "model": "dmeng/inkling-2-mini"
}
